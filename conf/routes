# Routes
# This file defines all application routes (Higher priority routes first)
# https://www.playframework.com/documentation/latest/ScalaRouting
# ~~~~

# An example controller showing a sample home page
GET     /                           controllers.HomeController.index()

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)

GET     /api/clubs                controllers.ClubController.getAll()
POST    /api/clubs/create                controllers.ClubController.create()
GET     /api/clubs/:id            controllers.ClubController.getById(id: Long)
PUT     /api/clubs/:id            controllers.ClubController.update(id: Long)
DELETE  /api/clubs/:id            controllers.ClubController.delete(id: Long)
GET     /api/clubs/getWithPlayers/:id  controllers.ClubController.getWithPlayers(id:Long)

GET     /api/players                controllers.PlayerController.getAll()
POST    /api/players/create                controllers.PlayerController.create()
GET     /api/players/clubs/:clubId   controllers.PlayerController.getByClubId(clubId: Long)
GET     /api/players/:id            controllers.PlayerController.getById(id: Long)
PUT     /api/players/:id            controllers.PlayerController.update(id: Long)
DELETE  /api/players/:id            controllers.PlayerController.delete(id: Long)

